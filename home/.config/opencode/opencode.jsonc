{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "instructions": [
      "/Users/vao/.config/opencode/instruct-*.md"
  ],
  "mcp": {
    "github-remote": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_TOKEN}"
      }
    },
    "gcp": {
        "type": "remote",
        "url": "https://developerknowledge.googleapis.com/mcp",
        "headers": {
            "X-Goog-Api-Key": "{env:GCP_MCP_API_KEY}"
        }
    },
    "grafana-quantumgas": {
        "enabled": true,
        "type": "local",
        "command": ["uvx", "mcp-grafana"],
        "environment": {
            "GRAFANA_URL": "https://quantumgas.grafana.net",
            "GRAFANA_SERVICE_ACCOUNT_TOKEN": "{env:GRAFANA_MCP_SERVICE_ACCOUNT_TOKEN}"
        }
    }
  },
  "plugin": [
      "opencode-ralph-loop"
      // "superpowers@git+https://github.com/obra/superpowers.git"
  ]
}
