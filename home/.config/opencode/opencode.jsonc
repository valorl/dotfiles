{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "instructions": [
      "/Users/vao/.config/opencode/instruct-*.md"
  ],
  "mcp": {
    "github-remote": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_TOKEN}"
      }
    },
    "gcp-knowledge": {
        "type": "remote",
        "url": "https://developerknowledge.googleapis.com/mcp",
        "headers": {
            "X-Goog-Api-Key": "{env:GCP_MCP_API_KEY}"
        }
    },
    "qgt-buckets-prod": {
        "type": "remote",
        "url": "https://storage.googleapis.com/storage/mcp",
        "headers": {
            "Authorization": "{env:GOOLE_TOKEN}",
            "x-goog-user-project": "qgt-buckets-prod"
        }
    },
    "grafana-quantumgas": {
        "enabled": true,
        "type": "local",
        "command": ["uvx", "mcp-grafana"],
        "environment": {
            "GRAFANA_URL": "https://quantumgas.grafana.net",
            "GRAFANA_SERVICE_ACCOUNT_TOKEN": "{env:GRAFANA_MCP_SERVICE_ACCOUNT_TOKEN}"
        }
    },
    "fastmail": {
        "enabled": true,
        "type": "remote",
        "url": "https://api.fastmail.com/mcp"
    }
  }
}
